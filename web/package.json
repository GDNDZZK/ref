{
  "name": "ref-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "gen": "node scripts/gen-theme.ts && node scripts/gen-icons.ts",
    "gen:check": "node scripts/gen-theme.ts --check && node scripts/gen-icons.ts --check",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node scripts/perf.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm gen:check && pnpm test"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "shiki": "^4.5.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
